# ==========================================
# PORTFOLIO AI CHATBOT CONFIGURATION
# ==========================================

# Choose LLM Provider: 'gemini' or 'groq' or 'local'
LLM_PROVIDER=gemini

# Google Gemini API Key (Get Free at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq API Key (Optional Free Tier: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# PostgreSQL Connection (Same database as Portfolio Backend)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio
DB_USER=postgres
DB_PASSWORD=1234

# Fallback Portfolio Backend API URL if Direct DB Connection is not used
PORTFOLIO_BE_URL=http://localhost:8080

# Service Port
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://nguyenquockhoaportfolio.vercel.app
